{
  "name": "vscode-bsp",
  "displayName": "BSP Client",
  "description": "A general Build Server Protocol client for VSCode",
  "version": "0.1.1",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.bsp",
    "workspaceContains:**/.bsp/*",
    "onCommand:bsp.browseServers",
    "onCommand:bsp.activate",
    "onDebugResolve:bsp-debug",
    "onDebugInitialConfigurations",
    "onTaskType:bsp"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "BSP Debug",
      "properties": {
        "bsp.debug.lldbInitCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "restricted": true,
          "description": "LLDB commands to run before attaching or launching. Applies to F5 and target Debug actions when the server identifies LLDB or returns no adapter type. The default is empty; launch.json initCommands overrides this setting."
        }
      }
    },
    "breakpoints": [
      {
        "language": "swift"
      },
      {
        "language": "objective-c"
      },
      {
        "language": "objective-cpp"
      },
      {
        "language": "c"
      },
      {
        "language": "cpp"
      },
      {
        "language": "scala"
      },
      {
        "language": "java"
      },
      {
        "language": "kotlin"
      }
    ],
    "debuggers": [
      {
        "type": "bsp-debug",
        "label": "BSP Debug",
        "languages": [
          "swift",
          "objective-c",
          "objective-cpp",
          "c",
          "cpp"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "initCommands": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Adapter initialization commands. For LLDB, overrides bsp.debug.lldbInitCommands for this launch configuration."
              },
              "connect": {
                "type": "object",
                "description": "DAP address returned by the build server.",
                "properties": {
                  "host": {
                    "type": "string"
                  },
                  "port": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  },
                  "socket": {
                    "type": "string"
                  }
                },
                "oneOf": [
                  {
                    "required": [
                      "host",
                      "port"
                    ]
                  },
                  {
                    "required": [
                      "socket"
                    ]
                  }
                ]
              },
              "program": {
                "type": "string",
                "description": "Executable path supplied by the build server."
              },
              "pid": {
                "type": "integer",
                "minimum": 1,
                "description": "Process ID supplied by the build server."
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": true,
                "description": "Stop when the debugger attaches or launches."
              },
              "connection": {
                "type": "string",
                "minLength": 1,
                "description": "Path to a BSP connection JSON file, relative to the workspace folder or absolute. Required when target selection is ambiguous."
              },
              "target": {
                "type": "string",
                "minLength": 1,
                "description": "Exact BSP target URI or a unique target display name. Omit to use the current Build Context, or choose a target if no Context selection is saved."
              },
              "buildPolicy": {
                "type": "string",
                "enum": [
                  "build",
                  "reuse"
                ],
                "default": "build",
                "description": "Build before execution, or reuse existing products. Reuse requires server support and is not valid for compile."
              }
            }
          },
          "attach": {
            "properties": {
              "initCommands": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Adapter initialization commands."
              },
              "connect": {
                "type": "object",
                "description": "DAP address returned by the build server.",
                "properties": {
                  "host": {
                    "type": "string"
                  },
                  "port": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  },
                  "socket": {
                    "type": "string"
                  }
                },
                "oneOf": [
                  {
                    "required": [
                      "host",
                      "port"
                    ]
                  },
                  {
                    "required": [
                      "socket"
                    ]
                  }
                ]
              },
              "program": {
                "type": "string",
                "description": "Executable path supplied by the build server."
              },
              "pid": {
                "type": "integer",
                "minimum": 1,
                "description": "Optional process ID for the selected target. Omit to attach when exactly one matching process is running."
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": true,
                "description": "Stop when the debugger attaches or launches."
              },
              "connection": {
                "type": "string",
                "minLength": 1,
                "description": "Path to a BSP connection JSON file, relative to the workspace folder or absolute. Required when target selection is ambiguous."
              },
              "target": {
                "type": "string",
                "minLength": 1,
                "description": "Exact BSP target URI or a unique target display name. Omit to use the current Build Context, or choose a target if no Context selection is saved."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "name": "BSP Debug",
            "type": "bsp-debug",
            "request": "launch",
            "stopOnEntry": true
          },
          {
            "name": "BSP Attach",
            "type": "bsp-debug",
            "request": "attach"
          }
        ],
        "configurationSnippets": [
          {
            "label": "BSP Debug",
            "description": "Request a debug session from the build server.",
            "body": {
              "name": "BSP Debug",
              "type": "bsp-debug",
              "request": "launch",
              "stopOnEntry": true
            }
          },
          {
            "label": "BSP Attach",
            "description": "Attach to a running target through its build server.",
            "body": {
              "name": "BSP Attach",
              "type": "bsp-debug",
              "request": "attach"
            }
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "bsp.browseServers",
        "title": "Browse BSP Servers…",
        "category": "BSP",
        "icon": "$(list-selection)"
      },
      {
        "command": "bsp.activate",
        "title": "Activate BSP Extension",
        "category": "BSP"
      },
      {
        "command": "bsp.refresh",
        "title": "Refresh Build Targets",
        "category": "BSP",
        "icon": "$(refresh)"
      },
      {
        "command": "bsp.showTargets",
        "title": "Show Build Targets",
        "category": "BSP"
      },
      {
        "command": "bsp.compile",
        "title": "Compile Target…",
        "shortTitle": "Compile Target",
        "category": "BSP",
        "icon": "$(rocket)"
      },
      {
        "command": "bsp.test",
        "title": "Build and Test Target",
        "shortTitle": "Build and Test",
        "category": "BSP",
        "icon": "$(check-all)"
      },
      {
        "command": "bsp.run",
        "title": "Build and Run Target",
        "shortTitle": "Build and Run",
        "category": "BSP",
        "icon": "$(triangle-right)"
      },
      {
        "command": "bsp.runWithoutBuilding",
        "title": "Run Without Building",
        "shortTitle": "Run Without Building",
        "category": "BSP",
        "icon": "$(play)"
      },
      {
        "command": "bsp.debugWithoutBuilding",
        "title": "Debug Without Building",
        "shortTitle": "Debug Without Building",
        "category": "BSP",
        "icon": "$(debug-alt)"
      },
      {
        "command": "bsp.debug",
        "title": "Debug Target",
        "shortTitle": "Debug Target",
        "category": "BSP",
        "icon": "$(debug-alt)"
      },
      {
        "command": "bsp.testWithoutBuilding",
        "title": "Test Without Building",
        "shortTitle": "Test Without Building",
        "category": "BSP",
        "icon": "$(beaker)"
      },
      {
        "command": "bsp.cleanCache",
        "title": "Clean Build Cache…",
        "category": "BSP",
        "icon": "$(clear-all)"
      },
      {
        "command": "bsp.revealBuildOutput",
        "title": "Reveal Build Output",
        "category": "BSP",
        "icon": "$(folder-opened)"
      },
      {
        "command": "bsp.revealTargetFolder",
        "title": "Navigate to Folder…",
        "category": "BSP",
        "icon": "$(folder-opened)"
      },
      {
        "command": "bsp.showOutput",
        "title": "Show BSP Output",
        "category": "BSP"
      },
      {
        "command": "bsp.discoverConnections",
        "title": "Discover BSP Connections",
        "category": "BSP",
        "icon": "$(search)"
      },
      {
        "command": "bsp.connectAll",
        "title": "Connect All BSP Servers",
        "category": "BSP",
        "icon": "$(plug)"
      },
      {
        "command": "bsp.disconnectAll",
        "title": "Disconnect BSP Servers",
        "category": "BSP",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "bsp.connectOrDiscover",
        "title": "Connect BSP Servers",
        "category": "BSP",
        "icon": "$(plug)"
      },
      {
        "command": "bsp.connectServer",
        "title": "Connect to Server",
        "category": "BSP",
        "icon": "$(plug)"
      },
      {
        "command": "bsp.disconnectServer",
        "title": "Disconnect from Server",
        "category": "BSP",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "bsp.compileDisabled",
        "title": "Compile Not Supported",
        "category": "BSP",
        "icon": "$(rocket)",
        "enablement": "false"
      },
      {
        "command": "bsp.testDisabled",
        "title": "Test Not Supported",
        "category": "BSP",
        "icon": "$(check-all)",
        "enablement": "false"
      },
      {
        "command": "bsp.runDisabled",
        "title": "Run Not Supported",
        "category": "BSP",
        "icon": "$(triangle-right)",
        "enablement": "false"
      },
      {
        "command": "bsp.debugDisabled",
        "title": "Debug Not Supported",
        "category": "BSP",
        "icon": "$(debug-alt)",
        "enablement": "false"
      },
      {
        "command": "bsp.addToFavorites",
        "title": "Add to Favorites",
        "category": "BSP",
        "icon": "$(star-empty)"
      },
      {
        "command": "bsp.removeFromFavorites",
        "title": "Remove from Favorites",
        "category": "BSP",
        "icon": "$(star-full)"
      },
      {
        "command": "bsp.reconnectFavorite",
        "title": "Reconnect to Server",
        "category": "BSP",
        "icon": "$(debug-restart)"
      },
      {
        "command": "bsp.cancelOperation",
        "title": "Cancel Target Operation",
        "category": "BSP",
        "icon": "$(close)"
      },
      {
        "command": "bsp.showBuildOutput",
        "title": "Show BSP Build Output",
        "category": "BSP"
      },
      {
        "command": "bsp.debugTests",
        "title": "Debug Tests",
        "category": "BSP",
        "icon": "$(debug-alt)"
      },
      {
        "command": "bsp.configureContext",
        "title": "Configure Build Context…",
        "category": "BSP",
        "icon": "$(settings-gear)",
        "shortTitle": "Configure Build Context"
      },
      {
        "command": "bsp.selectContextDimension",
        "title": "Select Configuration",
        "category": "BSP",
        "icon": "$(list-selection)"
      },
      {
        "command": "bsp.executeContext",
        "title": "Execute",
        "category": "BSP",
        "icon": "$(play)"
      },
      {
        "command": "bsp.refreshContexts",
        "title": "Refresh Build Contexts",
        "category": "BSP",
        "icon": "$(refresh)"
      },
      {
        "command": "bsp.contextCompile",
        "title": "Compile",
        "category": "BSP",
        "icon": "$(rocket)"
      },
      {
        "command": "bsp.contextRun",
        "title": "Run",
        "category": "BSP",
        "icon": "$(triangle-right)"
      },
      {
        "command": "bsp.contextTest",
        "title": "Test",
        "category": "BSP",
        "icon": "$(check-all)"
      },
      {
        "command": "bsp.contextDebug",
        "title": "Debug",
        "category": "BSP",
        "icon": "$(debug-alt)"
      },
      {
        "command": "bsp.contextRunWithoutBuilding",
        "title": "Run Without Building",
        "category": "BSP"
      },
      {
        "command": "bsp.contextTestWithoutBuilding",
        "title": "Test Without Building",
        "category": "BSP"
      },
      {
        "command": "bsp.contextDebugWithoutBuilding",
        "title": "Debug Without Building",
        "category": "BSP"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "bspTargets",
          "name": "BSP",
          "when": "bsp.enabled"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "bsp.browseServers",
          "when": "view == bspTargets",
          "group": "navigation"
        },
        {
          "command": "bsp.refresh",
          "when": "view == bspTargets",
          "group": "navigation"
        },
        {
          "command": "bsp.connectOrDiscover",
          "when": "view == bspTargets && !bsp.connected",
          "group": "navigation"
        },
        {
          "command": "bsp.disconnectAll",
          "when": "view == bspTargets && bsp.connected",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "bsp.revealTargetFolder",
          "when": "view == bspTargets && viewItem =~ /buildTarget|dependency/ && !(viewItem =~ /disconnected|loading/)",
          "group": "navigation@1"
        },
        {
          "command": "bsp.revealBuildOutput",
          "when": "view == bspTargets && viewItem =~ /buildTarget/ && !(viewItem =~ /disconnected|loading/)",
          "group": "navigation@2"
        },
        {
          "command": "bsp.cleanCache",
          "when": "view == bspTargets && viewItem =~ /buildTarget.*canCleanCache/ && !(viewItem =~ /disconnected|loading|busy/)",
          "group": "build@1"
        },
        {
          "command": "bsp.runWithoutBuilding",
          "when": "view == bspTargets && viewItem =~ /buildTarget.*canRun/ && !(viewItem =~ /disconnected|loading|busy/) && (!(viewItem =~ /supportsBuildContext/) || viewItem =~ /canReuseBuild/)",
          "group": "advanced@1"
        },
        {
          "command": "bsp.testWithoutBuilding",
          "when": "view == bspTargets && viewItem =~ /buildTarget.*canTest/ && !(viewItem =~ /disconnected|loading|busy/) && (!(viewItem =~ /supportsBuildContext/) || viewItem =~ /canReuseBuild/)",
          "group": "advanced@2"
        },
        {
          "command": "bsp.debugWithoutBuilding",
          "when": "view == bspTargets && viewItem =~ /buildTarget.*canDebug/ && !(viewItem =~ /disconnected|loading|busy/) && (!(viewItem =~ /supportsBuildContext/) || viewItem =~ /canReuseBuild/)",
          "group": "advanced@3"
        },
        {
          "command": "bsp.compile",
          "when": "view == bspTargets && viewItem =~ /buildTarget.*canCompile/ && !(viewItem =~ /busy/)",
          "group": "inline@1"
        },
        {
          "command": "bsp.test",
          "when": "view == bspTargets && viewItem =~ /buildTarget/ && viewItem =~ /canTest/ && !(viewItem =~ /busy/)",
          "group": "inline@2"
        },
        {
          "command": "bsp.run",
          "when": "view == bspTargets && viewItem =~ /buildTarget/ && viewItem =~ /canRun/ && !(viewItem =~ /busy/)",
          "group": "inline@3"
        },
        {
          "command": "bsp.debug",
          "when": "view == bspTargets && viewItem =~ /buildTarget/ && viewItem =~ /canDebug/ && !(viewItem =~ /busy/)",
          "group": "inline@4"
        },
        {
          "command": "bsp.compileDisabled",
          "when": "view == bspTargets && viewItem =~ /^buildTarget/ && !(viewItem =~ /canCompile/) && !(viewItem =~ /busy/)",
          "group": "inline@1"
        },
        {
          "command": "bsp.runDisabled",
          "when": "view == bspTargets && viewItem =~ /^buildTarget/ && !(viewItem =~ /canRun|canTest/) && !(viewItem =~ /busy/)",
          "group": "inline@3"
        },
        {
          "command": "bsp.debugDisabled",
          "when": "view == bspTargets && viewItem =~ /^buildTarget/ && !(viewItem =~ /canDebug/) && !(viewItem =~ /busy/)",
          "group": "inline@4"
        },
        {
          "command": "bsp.connectServer",
          "when": "view == bspTargets && viewItem == disconnectedBspServer",
          "group": "inline"
        },
        {
          "command": "bsp.disconnectServer",
          "when": "view == bspTargets && viewItem == connectedBspServer",
          "group": "inline"
        },
        {
          "command": "bsp.addToFavorites",
          "when": "view == bspTargets && viewItem =~ /buildTarget/ && !(viewItem =~ /favorite/)",
          "group": "favorites@1"
        },
        {
          "command": "bsp.removeFromFavorites",
          "when": "view == bspTargets && viewItem =~ /favorite/",
          "group": "favorites@1"
        },
        {
          "command": "bsp.reconnectFavorite",
          "when": "view == bspTargets && viewItem =~ /favorite.*disconnected/",
          "group": "connection@1"
        },
        {
          "command": "bsp.cancelOperation",
          "when": "view == bspTargets && viewItem =~ /buildTarget.*busy/ && !(viewItem =~ /cancelling/) && !(viewItem =~ /nonCancellable/)",
          "group": "inline@1"
        },
        {
          "command": "bsp.configureContext",
          "when": "view == bspTargets && viewItem =~ /buildContextScope/",
          "group": "configuration@1"
        },
        {
          "command": "bsp.contextCompile",
          "when": "view == bspTargets && viewItem =~ /buildContextScope.*canCompile/",
          "group": "inline@1"
        },
        {
          "command": "bsp.contextRun",
          "when": "view == bspTargets && viewItem =~ /buildContextScope.*canRun/",
          "group": "inline@2"
        },
        {
          "command": "bsp.contextTest",
          "when": "view == bspTargets && viewItem =~ /buildContextScope.*canTest/",
          "group": "inline@3"
        },
        {
          "command": "bsp.contextDebug",
          "when": "view == bspTargets && viewItem =~ /buildContextScope.*canDebug/",
          "group": "inline@4"
        },
        {
          "command": "bsp.contextRunWithoutBuilding",
          "when": "view == bspTargets && viewItem =~ /buildContextScope.*canRun/ && viewItem =~ /canReuseBuild/",
          "group": "advanced@1"
        },
        {
          "command": "bsp.contextTestWithoutBuilding",
          "when": "view == bspTargets && viewItem =~ /buildContextScope.*canTest/ && viewItem =~ /canReuseBuild/",
          "group": "advanced@2"
        },
        {
          "command": "bsp.contextDebugWithoutBuilding",
          "when": "view == bspTargets && viewItem =~ /buildContextScope.*canDebug/ && viewItem =~ /canReuseBuild/",
          "group": "advanced@3"
        }
      ],
      "commandPalette": [
        {
          "command": "bsp.connectServer",
          "when": "false"
        },
        {
          "command": "bsp.disconnectServer",
          "when": "false"
        },
        {
          "command": "bsp.compileDisabled",
          "when": "false"
        },
        {
          "command": "bsp.testDisabled",
          "when": "false"
        },
        {
          "command": "bsp.runDisabled",
          "when": "false"
        },
        {
          "command": "bsp.debugDisabled",
          "when": "false"
        },
        {
          "command": "bsp.addToFavorites",
          "when": "false"
        },
        {
          "command": "bsp.removeFromFavorites",
          "when": "false"
        },
        {
          "command": "bsp.reconnectFavorite",
          "when": "false"
        },
        {
          "command": "bsp.selectContextDimension",
          "when": "false"
        },
        {
          "command": "bsp.executeContext",
          "when": "false"
        },
        {
          "command": "bsp.contextCompile",
          "when": "false"
        },
        {
          "command": "bsp.contextRun",
          "when": "false"
        },
        {
          "command": "bsp.contextTest",
          "when": "false"
        },
        {
          "command": "bsp.contextDebug",
          "when": "false"
        },
        {
          "command": "bsp.contextRunWithoutBuilding",
          "when": "false"
        },
        {
          "command": "bsp.contextTestWithoutBuilding",
          "when": "false"
        },
        {
          "command": "bsp.contextDebugWithoutBuilding",
          "when": "false"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "bsp",
        "required": [
          "operation",
          "target"
        ],
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "compile",
              "run",
              "test"
            ],
            "description": "BSP operation to execute."
          },
          "connection": {
            "type": "string",
            "minLength": 1,
            "description": "Path to a BSP connection JSON file, relative to the workspace folder or absolute. Required when target selection is ambiguous."
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "description": "Exact BSP target URI or a unique target display name."
          },
          "buildPolicy": {
            "type": "string",
            "enum": [
              "build",
              "reuse"
            ],
            "default": "build",
            "description": "Build before execution, or reuse existing products. Reuse requires server support and is not valid for compile."
          }
        }
      }
    ]
  },
  "configuration": {
    "type": "object",
    "title": "BSP Configuration",
    "properties": {
      "bsp.favoriteTargets": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": [],
        "description": "List of favorite build target URIs"
      },
      "bsp.xcode.targets": {
        "type": "object",
        "default": {},
        "description": "Saved Xcode target configurations (scheme and destination selections)",
        "additionalProperties": {
          "type": "object",
          "properties": {
            "selectedConfiguration": {
              "type": "string",
              "description": "Selected Xcode configuration"
            },
            "selectedDestination": {
              "type": "string",
              "description": "Selected Xcode destination"
            },
            "lastUpdated": {
              "type": "string",
              "description": "Last update timestamp"
            }
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "test:protocol": "npm run compile && node --test test/*.test.cjs",
    "package": "vsce package",
    "install-local": "code --install-extension vscode-bsp-*.vsix"
  },
  "devDependencies": {
    "@types/node": "16.x",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "@vscode/test-electron": "^2.2.0",
    "eslint": "^8.28.0",
    "typescript": "^4.9.4"
  },
  "dependencies": {
    "vscode-jsonrpc": "^8.0.2"
  }
}
